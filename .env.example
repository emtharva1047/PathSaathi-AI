APP_ENV=development
APP_NAME=PathSaathi AI
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501
PATHSAATHI_API_URL=http://127.0.0.1:8000
PATHSAATHI_DATABASE_URL=sqlite:///./data/pathsaathi.db
DATABASE_ECHO=false
LOG_LEVEL=INFO
LLM_PROVIDER=disabled
LLM_API_KEY=

# For a PostgreSQL environment, install the optional driver with:
# pip install -e ".[postgres]"
# Then set PATHSAATHI_DATABASE_URL to a secret-managed
# postgresql+psycopg:// connection string. Do not commit credentials.
# Runtime validation: API_PORT must be 1-65535.
# DATABASE_ECHO accepts true/false, 1/0, yes/no or on/off.
# PATHSAATHI_DATABASE_URL must be a valid SQLite or PostgreSQL SQLAlchemy URL.
